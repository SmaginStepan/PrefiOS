// Copy to Secrets.xcconfig (git-ignored) and fill in. NEVER commit the real file:
// this repository is public.

// ScoreServer credentials (the same pair the Android app embeds).
PREF_SCORE_API_KEY = your-score-api-key
PREF_SCORE_SECRET = your-score-hmac-secret

// AdMob ids for the iOS app (separate from the Android ones). Leave empty to
// ship without ads. Debug builds ignore these and use Google's test ids.
PREF_ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
PREF_ADMOB_INTERSTITIAL_ID = ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
